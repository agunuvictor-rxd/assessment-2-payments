# Assessment 2 — Payment and Subscription Slice Environment Configuration

# HTTP Port (default: 3001)
PORT=3001

# Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Session Cookie Secret (minimum 32-character string)
SESSION_SECRET=payment-slice-session-secret-key-at-least-32-chars!

# SQLite Database Path
DB_PATH=./payments.db

# Payment Provider Simulation Secret Keys
# Used to verify incoming webhook signatures (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=whsec_test_secret_key_for_signature_verification_32ch
PAYMENT_API_KEY=test_sk_payment_provider_api_key_sample

# Pro Plan Pricing in minor units (integer cents)
# $20.00 = 2000 cents
PRO_MONTHLY_CENTS=2000
# $200.00 = 20000 cents
PRO_YEARLY_CENTS=20000
DEFAULT_CURRENCY=USD
